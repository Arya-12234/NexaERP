DJANGO_SECRET_KEY=change-me
USE_SQLITE=true

# PostgreSQL (used when USE_SQLITE is unset/false)
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional Firebase Admin SDK credentials for token verification.
# Either place your key at apps/Users/serviceAccountKey.json (default), or set:
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/your-service-account.json
